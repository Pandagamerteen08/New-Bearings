
{
  "productName": "New Bearings",
  "version": "0.1.0",
  "identifier": "com.newbearings.desktop",
"build": {
  "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
  "devUrl": "http://localhost:5173",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "frontend/dist"
},
  "app": {
    "windows": [
      {
        "title": "New Bearings",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
    "bundle": {
        "active": false,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
